// ====

// RUN: emit amdgpu-kernel-assembly

// The scratch base follows all enabled user inputs, and the wave offset
// follows the enabled workgroup IDs. Both die before body register allocation.
amdgpu.target<gfx90a> @target

low.kernel.def target<amdgpu.cdna2.core>(@target) workgroup_size(64, 1, 1) @private_storage() asm {
  %arguments = live_in<amdgpu.kernarg_segment_ptr> : reg<amdgpu.sgpr x2>
  %dispatch = live_in<amdgpu.dispatch_id> : reg<amdgpu.sgpr x2>
  %group_x = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %group_y = live_in<amdgpu.workgroup_id.y> : reg<amdgpu.sgpr>
  %group_z = live_in<amdgpu.workgroup_id.z> : reg<amdgpu.sgpr>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %storage = storage {byte_alignment = 16, byte_length = 16} : low.storage<private>
  %groups = s_add_u32 %group_x, %group_y
  %group = s_add_u32 %groups, %group_z
  %value = v_add_u32 %group, %lane
  low.spill %value, %storage : reg<amdgpu.vgpr>, low.storage<private>
  %reload = low.reload %storage : low.storage<private> -> reg<amdgpu.vgpr>
  %sum = v_add_u32 %reload, %lane
  return
}


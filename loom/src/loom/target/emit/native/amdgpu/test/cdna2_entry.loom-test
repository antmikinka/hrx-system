// RUN: emit amdgpu-kernel-assembly

// Workgroup IDs retain their launch positions even when private storage is
// absent. No flat-scratch initialization instructions or inputs are needed.
amdgpu.target<gfx90a> @target

low.kernel.def target<amdgpu.cdna2.core>(@target) workgroup_size(64, 1, 1) @no_private_storage() asm {
  %group = live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
  %lane = live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
  %value = v_add_u32 %group, %lane
  return
}


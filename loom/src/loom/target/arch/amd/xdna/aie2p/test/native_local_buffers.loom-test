// RUN: emit source-low output=low

aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

// A core addresses the complete allocation through a neighboring tile's load
// window while the owning tile retains the storage reservation.
pipeline.def<kernel> public retain target(@device) @local_capture() run() {
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %bytes = index.constant 64 : offset
  %origin = index.constant 0 : offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %view = buffer.view %storage[%origin] : buffer -> view<16xi32>
    %value = vector.constant 42 : vector<16xi32>
    vector.store %value, %view[0] : vector<16xi32>, view<16xi32>
  }
}

// ----
low.func.def inline target<amd.xdna.aie2p.core> @__pipeline_worker_0() asm {
  %view = mov.local-address 262144
  %34 = mov.short 42
  %value = vbcst.32 %34
  vst.512.i32x16 %value, %view, 0
  %12 = mov.i32 1
  rel %12, 48
  low.br ^_bb1
^_bb1:
  %13 = mov.ss
  low.br ^_bb1
}

low.func.def target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_2) @__aie2p_worker_helper_3() asm {
  %20 = constant 3350528 : reg<aie2p.config.scalar : i64>
  %21 = constant 3 : reg<aie2p.config.scalar : i64>
  %22 = constant 2 : reg<aie2p.config.scalar : i64>
  write.mask32 %20, %21, %22
  %23 = constant 0 : reg<aie2p.config.scalar : i64>
  program.load %23, %21, @__pipeline_worker_0
  %24 = constant 64 : reg<aie2p.config.scalar : i64>
  data.reserve %23, %22, %23, %24
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_2) @__aie2p_worker_helper_4() asm {
  %25 = constant 3272704 : reg<aie2p.config.scalar : i64>
  %26 = constant 0 : reg<aie2p.config.scalar : i64>
  write32 %25, %26
  %27 = constant 3350528 : reg<aie2p.config.scalar : i64>
  %28 = constant 2 : reg<aie2p.config.scalar : i64>
  write.mask32 %27, %28, %26
  %29 = constant 1 : reg<aie2p.config.scalar : i64>
  write.mask32 %27, %29, %29
  %30 = constant 63 : reg<aie2p.config.scalar : i64>
  wait.mask32 %25, %30, %29
  %31 = constant 3 : reg<aie2p.config.scalar : i64>
  write.mask32 %27, %31, %28
  return
}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_2) abi(array_program) @local_capture() asm {
  %32 = constant 1 : reg<aie2p.config.scalar : i64>
  entry %32, @__aie2p_worker_helper_3, @__aie2p_worker_helper_4
  return
}

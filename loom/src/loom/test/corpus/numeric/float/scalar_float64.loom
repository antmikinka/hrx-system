// Inputs arrive as raw bits, preserving signaling NaNs and signed zeros.
// Normalize only the NaN sign and payload; a signaling result still fails.
func.def inline @scalar_float64_result_bits(%value: f64) -> (i64) {
  %bits = scalar.bitcast %value : f64 to i64
  %is_nan = scalar.cmpf uno, %value, %value : f64
  %quiet_bit = scalar.constant 2251799813685248 : i64
  %exponent = scalar.constant 9218868437227405312 : i64
  %quiet = scalar.andi %bits, %quiet_bit : i64
  %tag = scalar.ori %quiet, %exponent : i64
  %observed = scf.select %is_nan, %tag, %bits : i64
  func.return %observed : i64
}

func.def @scalar_float64_pair(%lhs_bits: i64, %rhs_bits: i64, %arithmetic: buffer, %predicates: buffer) {
  %base = index.constant 0 : offset
  %numbers = buffer.view %arithmetic[%base] : buffer -> view<12xi64>
  %conditions = buffer.view %predicates[%base] : buffer -> view<14xi32>
  %lhs = scalar.bitcast %lhs_bits : i64 to f64
  %rhs = scalar.bitcast %rhs_bits : i64 to f64
  %addf = scalar.addf %lhs, %rhs : f64
  %addf_bits = func.call @scalar_float64_result_bits(%addf) : (f64) -> (i64)
  %subf = scalar.subf %lhs, %rhs : f64
  %subf_bits = func.call @scalar_float64_result_bits(%subf) : (f64) -> (i64)
  %mulf = scalar.mulf %lhs, %rhs : f64
  %mulf_bits = func.call @scalar_float64_result_bits(%mulf) : (f64) -> (i64)
  %divf = scalar.divf %lhs, %rhs : f64
  %divf_bits = func.call @scalar_float64_result_bits(%divf) : (f64) -> (i64)
  %fmaf = scalar.fmaf %lhs, %rhs, %lhs : f64
  %fmaf_bits = func.call @scalar_float64_result_bits(%fmaf) : (f64) -> (i64)
  %absf = scalar.absf %lhs : f64
  %absf_bits = func.call @scalar_float64_result_bits(%absf) : (f64) -> (i64)
  %negf = scalar.negf %lhs : f64
  %negf_bits = func.call @scalar_float64_result_bits(%negf) : (f64) -> (i64)
  %copysignf = scalar.copysignf %lhs, %rhs : f64
  %copysignf_bits = func.call @scalar_float64_result_bits(%copysignf) : (f64) -> (i64)
  %minimumf = scalar.minimumf %lhs, %rhs : f64
  %minimumf_bits = func.call @scalar_float64_result_bits(%minimumf) : (f64) -> (i64)
  %maximumf = scalar.maximumf %lhs, %rhs : f64
  %maximumf_bits = func.call @scalar_float64_result_bits(%maximumf) : (f64) -> (i64)
  %minnumf = scalar.minnumf %lhs, %rhs : f64
  %minnumf_bits = func.call @scalar_float64_result_bits(%minnumf) : (f64) -> (i64)
  %maxnumf = scalar.maxnumf %lhs, %rhs : f64
  %maxnumf_bits = func.call @scalar_float64_result_bits(%maxnumf) : (f64) -> (i64)
  view.store %addf_bits, %numbers[0] : i64, view<12xi64>
  view.store %subf_bits, %numbers[1] : i64, view<12xi64>
  view.store %mulf_bits, %numbers[2] : i64, view<12xi64>
  view.store %divf_bits, %numbers[3] : i64, view<12xi64>
  view.store %fmaf_bits, %numbers[4] : i64, view<12xi64>
  view.store %absf_bits, %numbers[5] : i64, view<12xi64>
  view.store %negf_bits, %numbers[6] : i64, view<12xi64>
  view.store %copysignf_bits, %numbers[7] : i64, view<12xi64>
  view.store %minimumf_bits, %numbers[8] : i64, view<12xi64>
  view.store %maximumf_bits, %numbers[9] : i64, view<12xi64>
  view.store %minnumf_bits, %numbers[10] : i64, view<12xi64>
  view.store %maxnumf_bits, %numbers[11] : i64, view<12xi64>
  %oeq = scalar.cmpf oeq, %lhs, %rhs : f64
  %oeq_word = scalar.extui %oeq : i1 to i32
  view.store %oeq_word, %conditions[0] : i32, view<14xi32>
  %ogt = scalar.cmpf ogt, %lhs, %rhs : f64
  %ogt_word = scalar.extui %ogt : i1 to i32
  view.store %ogt_word, %conditions[1] : i32, view<14xi32>
  %oge = scalar.cmpf oge, %lhs, %rhs : f64
  %oge_word = scalar.extui %oge : i1 to i32
  view.store %oge_word, %conditions[2] : i32, view<14xi32>
  %olt = scalar.cmpf olt, %lhs, %rhs : f64
  %olt_word = scalar.extui %olt : i1 to i32
  view.store %olt_word, %conditions[3] : i32, view<14xi32>
  %ole = scalar.cmpf ole, %lhs, %rhs : f64
  %ole_word = scalar.extui %ole : i1 to i32
  view.store %ole_word, %conditions[4] : i32, view<14xi32>
  %one = scalar.cmpf one, %lhs, %rhs : f64
  %one_word = scalar.extui %one : i1 to i32
  view.store %one_word, %conditions[5] : i32, view<14xi32>
  %ord = scalar.cmpf ord, %lhs, %rhs : f64
  %ord_word = scalar.extui %ord : i1 to i32
  view.store %ord_word, %conditions[6] : i32, view<14xi32>
  %ueq = scalar.cmpf ueq, %lhs, %rhs : f64
  %ueq_word = scalar.extui %ueq : i1 to i32
  view.store %ueq_word, %conditions[7] : i32, view<14xi32>
  %ugt = scalar.cmpf ugt, %lhs, %rhs : f64
  %ugt_word = scalar.extui %ugt : i1 to i32
  view.store %ugt_word, %conditions[8] : i32, view<14xi32>
  %uge = scalar.cmpf uge, %lhs, %rhs : f64
  %uge_word = scalar.extui %uge : i1 to i32
  view.store %uge_word, %conditions[9] : i32, view<14xi32>
  %ult = scalar.cmpf ult, %lhs, %rhs : f64
  %ult_word = scalar.extui %ult : i1 to i32
  view.store %ult_word, %conditions[10] : i32, view<14xi32>
  %ule = scalar.cmpf ule, %lhs, %rhs : f64
  %ule_word = scalar.extui %ule : i1 to i32
  view.store %ule_word, %conditions[11] : i32, view<14xi32>
  %une = scalar.cmpf une, %lhs, %rhs : f64
  %une_word = scalar.extui %une : i1 to i32
  view.store %une_word, %conditions[12] : i32, view<14xi32>
  %uno = scalar.cmpf uno, %lhs, %rhs : f64
  %uno_word = scalar.extui %uno : i1 to i32
  view.store %uno_word, %conditions[13] : i32, view<14xi32>
  func.return
}

// Both subjects receive the same runtime bit patterns, independently of which
// arithmetic operations the selected target implements.
func.def inline @scalar_float64_special_inputs(%ordinal: index) -> (i64, i64) {
  %lhs, %rhs = scf.switch %ordinal -> (i64, i64) {
    case 0 {
      %lhs = scalar.constant -4616189618054758400 : i64
      %rhs = scalar.constant 4611686018427387904 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 1 {
      %lhs = scalar.constant 0 : i64
      %rhs = scalar.constant -9223372036854775808 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 2 {
      %lhs = scalar.constant -9223372036854775808 : i64
      %rhs = scalar.constant 0 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 3 {
      %lhs = scalar.constant -9223372036854775808 : i64
      %rhs = scalar.constant -9223372036854775808 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 4 {
      %lhs = scalar.constant 9218868437227405312 : i64
      %rhs = scalar.constant -4503599627370496 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 5 {
      %lhs = scalar.constant 1 : i64
      %rhs = scalar.constant -9223372036854775807 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 6 {
      %lhs = scalar.constant 4503599627370496 : i64
      %rhs = scalar.constant 4503599627370495 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 7 {
      %lhs = scalar.constant 4607182418800017408 : i64
      %rhs = scalar.constant 4368491638549381120 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 8 {
      %lhs = scalar.constant 4607182418800017409 : i64
      %rhs = scalar.constant 4368491638549381120 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 9 {
      %lhs = scalar.constant 9221120237041090851 : i64
      %rhs = scalar.constant 4611686018427387904 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 10 {
      %lhs = scalar.constant -2251799813684138 : i64
      %rhs = scalar.constant 4611686018427387904 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 11 {
      %lhs = scalar.constant 9218868437227407241 : i64
      %rhs = scalar.constant 4611686018427387904 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 12 {
      %lhs = scalar.constant -4503599627367748 : i64
      %rhs = scalar.constant 4611686018427387904 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 13 {
      %lhs = scalar.constant 4611686018427387904 : i64
      %rhs = scalar.constant 9221120237041090851 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 14 {
      %lhs = scalar.constant 4611686018427387904 : i64
      %rhs = scalar.constant -2251799813684138 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 15 {
      %lhs = scalar.constant 4611686018427387904 : i64
      %rhs = scalar.constant 9218868437227407241 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 16 {
      %lhs = scalar.constant 4611686018427387904 : i64
      %rhs = scalar.constant -4503599627367748 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    case 17 {
      %lhs = scalar.constant 9221120237041090851 : i64
      %rhs = scalar.constant 9218868437227407241 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
    default {
      %lhs = scalar.constant -4503599627367748 : i64
      %rhs = scalar.constant -2251799813684138 : i64
      scf.yield %lhs, %rhs : i64, i64
    }
  }
  func.return %lhs, %rhs : i64, i64
}

check.scenario @scalar_float64_special_values {
  check.trial[19](%trial: index, %entropy: check.entropy) {
    %lhs, %rhs = check.generate<@scalar_float64_special_inputs>(%trial) : (index) -> (i64, i64)
    %numbers = check.generate.fill value(-1) : tensor<12xi64>
    %conditions = check.generate.fill value(-1) : tensor<14xi32>
    check.compare<@scalar_float64_pair>(%lhs, %rhs, %numbers, %conditions) : (i64, i64, tensor<12xi64>, tensor<14xi32>) -> () {
      check.expect.bitwise actual(%numbers) expected(%numbers) : tensor<12xi64>
      check.expect.bitwise actual(%conditions) expected(%conditions) : tensor<14xi32>
    }
  }
  check.return
}

check.scenario @scalar_float64_random_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %lhs = check.entropy.read %entropy[0] : check.entropy -> i64
    %rhs = check.entropy.read %entropy[1] : check.entropy -> i64
    %numbers = check.generate.fill value(-1) : tensor<12xi64>
    %conditions = check.generate.fill value(-1) : tensor<14xi32>
    check.compare<@scalar_float64_pair>(%lhs, %rhs, %numbers, %conditions) : (i64, i64, tensor<12xi64>, tensor<14xi32>) -> () {
      check.expect.bitwise actual(%numbers) expected(%numbers) : tensor<12xi64>
      check.expect.bitwise actual(%conditions) expected(%conditions) : tensor<14xi32>
    }
  }
  check.return
}

// Remainder has an independent lowering contract; its availability must not
// prevent observing ordinary arithmetic and predicates.
func.def @scalar_float64_remainder(%lhs_bits: i64, %rhs_bits: i64, %output: buffer) {
  %lhs = scalar.bitcast %lhs_bits : i64 to f64
  %rhs = scalar.bitcast %rhs_bits : i64 to f64
  %remainder = scalar.remf %lhs, %rhs : f64
  %bits = func.call @scalar_float64_result_bits(%remainder) : (f64) -> (i64)
  %origin = index.constant 0 : offset
  %result = buffer.view %output[%origin] : buffer -> view<1xi64>
  view.store %bits, %result[0] : i64, view<1xi64>
  func.return
}

check.scenario @scalar_float64_remainder_special_values {
  check.trial[19](%trial: index, %entropy: check.entropy) {
    %lhs, %rhs = check.generate<@scalar_float64_special_inputs>(%trial) : (index) -> (i64, i64)
    %output = check.generate.fill value(-1) : tensor<1xi64>
    check.compare<@scalar_float64_remainder>(%lhs, %rhs, %output) : (i64, i64, tensor<1xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi64>
    }
  }
  check.return
}

check.scenario @scalar_float64_remainder_random_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %lhs = check.entropy.read %entropy[0] : check.entropy -> i64
    %rhs = check.entropy.read %entropy[1] : check.entropy -> i64
    %output = check.generate.fill value(-1) : tensor<1xi64>
    check.compare<@scalar_float64_remainder>(%lhs, %rhs, %output) : (i64, i64, tensor<1xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi64>
    }
  }
  check.return
}

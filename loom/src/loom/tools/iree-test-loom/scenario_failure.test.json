{
  "version": 1,
  "cases": [
    {
      "name": "attributes a wrong result to its replayable trial",
      "run": {
        "tool": "scenario-failure-test",
        "args": [
          "{srcdir}/testdata/scenario_failures.loom",
          "--case=@wrong_result"
        ]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": [
          "\"scenario_count\":1",
          "\"trial_count\":3",
          "\"failed_trial_count\":1",
          "\"scenario\":\"wrong_result\",\"action\":\"compare\"",
          "\"configuration_ordinal\":0,\"trial_index\":0,\"trial_ordinal\":0,\"passed\":true",
          "\"entropy\":\"0x29b9d6df0d14db0f274d51698d27ffe7\",\"configuration_ordinal\":0,\"trial_index\":0,\"trial_ordinal\":1,\"passed\":false",
          "\"index\":0,\"kind\":\"equal\"",
          "actual i32 value 42 does not equal expected 41",
          "\"start_line\":15,\"start_column\":7,\"end_line\":15,\"end_column\":67",
          "\"configuration_ordinal\":0,\"trial_index\":0,\"trial_ordinal\":2,\"passed\":true"
        ]
      }
    },
    {
      "name": "attributes wrong mutable post-state to its replayable trial",
      "run": {
        "tool": "scenario-failure-test",
        "args": [
          "{srcdir}/testdata/scenario_failures.loom",
          "--case=@wrong_post_state"
        ]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": [
          "\"scenario_count\":1",
          "\"trial_count\":3",
          "\"failed_trial_count\":1",
          "\"scenario\":\"wrong_post_state\",\"action\":\"compare\"",
          "\"configuration_ordinal\":0,\"trial_index\":0,\"trial_ordinal\":0,\"passed\":true",
          "\"entropy\":\"0x29b9d6df0d14db0f274d51698d27ffe7\",\"configuration_ordinal\":0,\"trial_index\":0,\"trial_ordinal\":1,\"passed\":false",
          "\"index\":0,\"kind\":\"bitwise\"",
          "element at index 0 (12) does not match the expected (11)",
          "\"start_line\":25,\"start_column\":7,\"end_line\":25,\"end_column\":79",
          "\"configuration_ordinal\":0,\"trial_index\":0,\"trial_ordinal\":2,\"passed\":true"
        ]
      }
    },
    {
      "name": "accepts an expected scenario check failure",
      "run": {
        "tool": "scenario-failure-test",
        "args": [
          "{srcdir}/testdata/scenario_failures.loom",
          "--case=@wrong_post_state",
          "--xfail=@wrong_post_state=EXPECT/002"
        ]
      },
      "stdout": {
        "contains": [
          "\"failed_trial_count\":1",
          "\"xfail_count\":1",
          "\"xpass_count\":0",
          "\"xfail_mismatch_count\":0",
          "\"diagnostic\":\"EXPECT/002\"",
          "\"record\":\"@wrong_post_state\",\"diagnostic\":\"EXPECT/002\",\"outcome\":\"xfail\""
        ]
      }
    },
    {
      "name": "fails when a scenario check diagnostic drifts",
      "run": {
        "tool": "scenario-failure-test",
        "args": [
          "{srcdir}/testdata/scenario_failures.loom",
          "--case=@wrong_post_state",
          "--xfail=@wrong_post_state=EXPECT/001"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": [
          "\"xfail_count\":0",
          "\"xfail_mismatch_count\":1",
          "\"record\":\"@wrong_post_state\",\"diagnostic\":\"EXPECT/001\",\"outcome\":\"diagnostic_mismatch\",\"observed_diagnostic\":\"EXPECT/002\""
        ]
      }
    },
